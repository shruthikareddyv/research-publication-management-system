 package org.example.dao;

import org.example.database.DBConnection;
import org.example.model.Publication;

import java.sql.Connection;
import java.sql.PreparedStatement;

public class PublicationDAO {

    public void addPublication(Publication publication) {

        String sql = "INSERT INTO Publication " +
                "(Publication_ID, Title, Year, Publisher, DOI, URL, Publication_Type) " +
                "VALUES (?, ?, ?, ?, ?, ?, ?)";

        try {
            Connection connection = DBConnection.getConnection();

            PreparedStatement statement =
                    connection.prepareStatement(sql);

            statement.setInt(1, publication.getPublicationId());
            statement.setString(2, publication.getTitle());
            statement.setInt(3, publication.getYear());
            statement.setString(4, publication.getPublisher());
            statement.setString(5, publication.getDoi());
            statement.setString(6, publication.getUrl());
            statement.setString(7, publication.getPublicationType());

            statement.executeUpdate();

            System.out.println("Publication added successfully!");

            statement.close();
            connection.close();

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
