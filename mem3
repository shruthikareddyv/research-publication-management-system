package org.example.ui;

import javax.swing.*;

import org.example.dao.PublicationDAO;
import org.example.dao.JournalDAO;
import org.example.dao.ConferenceDAO;
import org.example.dao.BookDAO;
import org.example.dao.BookChapterDAO;
import org.example.model.Publication;

public class PublicationForm extends JFrame {

    public PublicationForm() {

        setTitle("Faculty Publication System");
        setSize(650, 650);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(null);

        // Heading
        JLabel heading = new JLabel("Faculty Publication System");
        heading.setBounds(200, 20, 250, 30);
        add(heading);

        // Publication ID
        JLabel idLabel = new JLabel("Publication ID:");
        idLabel.setBounds(50, 70, 120, 25);
        add(idLabel);

        JTextField idField = new JTextField();
        idField.setBounds(180, 70, 300, 25);
        add(idField);

        // Title
        JLabel titleLabel = new JLabel("Title:");
        titleLabel.setBounds(50, 110, 120, 25);
        add(titleLabel);

        JTextField titleField = new JTextField();
        titleField.setBounds(180, 110, 300, 25);
        add(titleField);

        // Year
        JLabel yearLabel = new JLabel("Year:");
        yearLabel.setBounds(50, 150, 120, 25);
        add(yearLabel);

        JTextField yearField = new JTextField();
        yearField.setBounds(180, 150, 300, 25);
        add(yearField);

        // Publisher
        JLabel publisherLabel = new JLabel("Publisher:");
        publisherLabel.setBounds(50, 190, 120, 25);
        add(publisherLabel);

        JTextField publisherField = new JTextField();
        publisherField.setBounds(180, 190, 300, 25);
        add(publisherField);

        // DOI
        JLabel doiLabel = new JLabel("DOI:");
        doiLabel.setBounds(50, 230, 120, 25);
        add(doiLabel);

        JTextField doiField = new JTextField();
        doiField.setBounds(180, 230, 300, 25);
        add(doiField);

        // URL
        JLabel urlLabel = new JLabel("URL:");
        urlLabel.setBounds(50, 270, 120, 25);
        add(urlLabel);

        JTextField urlField = new JTextField();
        urlField.setBounds(180, 270, 300, 25);
        add(urlField);

        // Publication Type
        JLabel typeLabel = new JLabel("Publication Type:");
        typeLabel.setBounds(50, 310, 120, 25);
        add(typeLabel);

        String[] types = {
                "Journal",
                "Conference",
                "Book",
                "Book Chapter"
        };

        JComboBox<String> typeBox = new JComboBox<>(types);
        typeBox.setBounds(180, 310, 300, 25);
        add(typeBox);

        // Journal fields
        JLabel volumeLabel = new JLabel("Volume:");
        volumeLabel.setBounds(50, 360, 120, 25);

        JTextField volumeField = new JTextField();
        volumeField.setBounds(180, 360, 300, 25);

        JLabel issueLabel = new JLabel("Issue:");
        issueLabel.setBounds(50, 400, 120, 25);

        JTextField issueField = new JTextField();
        issueField.setBounds(180, 400, 300, 25);

        JLabel pagesLabel = new JLabel("Pages:");
        pagesLabel.setBounds(50, 440, 120, 25);

        JTextField pagesField = new JTextField();
        pagesField.setBounds(180, 440, 300, 25);

        // Conference field
        JLabel conferenceDateLabel = new JLabel("Conference Date:");
        conferenceDateLabel.setBounds(50, 360, 120, 25);

        JTextField conferenceDateField = new JTextField();
        conferenceDateField.setBounds(180, 360, 300, 25);

        // Book fields
        JLabel isbnLabel = new JLabel("ISBN:");
        isbnLabel.setBounds(50, 360, 120, 25);

        JTextField isbnField = new JTextField();
        isbnField.setBounds(180, 360, 300, 25);

        JLabel editionLabel = new JLabel("Edition:");
        editionLabel.setBounds(50, 400, 120, 25);

        JTextField editionField = new JTextField();
        editionField.setBounds(180, 400, 300, 25);

        // Book Chapter fields
        JLabel bookTitleLabel = new JLabel("Book Title:");
        bookTitleLabel.setBounds(50, 360, 120, 25);

        JTextField bookTitleField = new JTextField();
        bookTitleField.setBounds(180, 360, 300, 25);

        JLabel chapterLabel = new JLabel("Chapter Number:");
        chapterLabel.setBounds(50, 400, 120, 25);

        JTextField chapterField = new JTextField();
        chapterField.setBounds(180, 400, 300, 25);

        JLabel chapterPagesLabel = new JLabel("Pages:");
        chapterPagesLabel.setBounds(50, 440, 120, 25);

        JTextField chapterPagesField = new JTextField();
        chapterPagesField.setBounds(180, 440, 300, 25);

        // Add Publication button
        JButton addButton = new JButton("Add Publication");
        addButton.setBounds(200, 500, 180, 35);
        add(addButton);

        // Show / hide fields
        Runnable updateFields = () -> {

            volumeLabel.setVisible(false);
            volumeField.setVisible(false);

            issueLabel.setVisible(false);
            issueField.setVisible(false);

            pagesLabel.setVisible(false);
            pagesField.setVisible(false);

            conferenceDateLabel.setVisible(false);
            conferenceDateField.setVisible(false);

            isbnLabel.setVisible(false);
            isbnField.setVisible(false);

            editionLabel.setVisible(false);
            editionField.setVisible(false);

            bookTitleLabel.setVisible(false);
            bookTitleField.setVisible(false);

            chapterLabel.setVisible(false);
            chapterField.setVisible(false);

            chapterPagesLabel.setVisible(false);
            chapterPagesField.setVisible(false);

            String selectedType =
                    (String) typeBox.getSelectedItem();

            if (selectedType.equals("Journal")) {

                add(volumeLabel);
                add(volumeField);
                add(issueLabel);
                add(issueField);
                add(pagesLabel);
                add(pagesField);

                volumeLabel.setVisible(true);
                volumeField.setVisible(true);

                issueLabel.setVisible(true);
                issueField.setVisible(true);

                pagesLabel.setVisible(true);
                pagesField.setVisible(true);

            } else if (selectedType.equals("Conference")) {

                add(conferenceDateLabel);
                add(conferenceDateField);

                conferenceDateLabel.setVisible(true);
                conferenceDateField.setVisible(true);

            } else if (selectedType.equals("Book")) {

                add(isbnLabel);
                add(isbnField);
                add(editionLabel);
                add(editionField);

                isbnLabel.setVisible(true);
                isbnField.setVisible(true);

                editionLabel.setVisible(true);
                editionField.setVisible(true);

            } else if (selectedType.equals("Book Chapter")) {

                add(bookTitleLabel);
                add(bookTitleField);
                add(chapterLabel);
                add(chapterField);
                add(chapterPagesLabel);
                add(chapterPagesField);

                bookTitleLabel.setVisible(true);
                bookTitleField.setVisible(true);

                chapterLabel.setVisible(true);
                chapterField.setVisible(true);

                chapterPagesLabel.setVisible(true);
                chapterPagesField.setVisible(true);
            }

            repaint();
        };

        // Change fields when type changes
        typeBox.addActionListener(e -> updateFields.run());

        // Add Publication button action
        addButton.addActionListener(e -> {

            try {

                int id = Integer.parseInt(idField.getText());

                String title = titleField.getText();

                int year = Integer.parseInt(yearField.getText());

                String publisher = publisherField.getText();

                String doi = doiField.getText();

                String url = urlField.getText();

                // Get selected publication type
                String selectedType =
                        (String) typeBox.getSelectedItem();

                // Create Publication object
                Publication publication = new Publication(
                        id,
                        title,
                        year,
                        publisher,
                        doi,
                        url,
                        selectedType
                );

                // Save common publication details
                PublicationDAO publicationDAO =
                        new PublicationDAO();

                publicationDAO.addPublication(publication);

                // Save type-specific details

                if (selectedType.equals("Journal")) {

                    JournalDAO dao = new JournalDAO();

                    dao.addJournal(
                            id,
                            volumeField.getText(),
                            issueField.getText(),
                            pagesField.getText()
                    );

                } else if (selectedType.equals("Conference")) {

                    ConferenceDAO dao =
                            new ConferenceDAO();

                    dao.addConference(
                            id,
                            conferenceDateField.getText()
                    );

                } else if (selectedType.equals("Book")) {

                    BookDAO dao = new BookDAO();

                    dao.addBook(
                            id,
                            isbnField.getText(),
                            editionField.getText()
                    );

                } else if (selectedType.equals("Book Chapter")) {

                    BookChapterDAO dao =
                            new BookChapterDAO();

                    int chapterNumber =
                            Integer.parseInt(
                                    chapterField.getText()
                            );

                    dao.addBookChapter(
                            id,
                            bookTitleField.getText(),
                            chapterNumber,
                            chapterPagesField.getText()
                    );
                }

                JOptionPane.showMessageDialog(
                        this,
                        "Publication added successfully!"
                );

            } catch (Exception ex) {

                JOptionPane.showMessageDialog(
                        this,
                        "Error: " + ex.getMessage()
                );
            }
        });

        // Show default fields
        updateFields.run();

        setVisible(true);
    }

    public static void main(String[] args) {
        new PublicationForm();
    }
}
